WhatsApp, ek sathe.\n// ⚠️ REPLACE-ME: niche WORKER_URL-e tomar asol Worker URL bosao.\n//    Worker deploy korar pore Cloudflare je URL dibe (jemon\n//    https://uob-admission-hub.<tomar-subdomain>.workers.dev), oita\n//    ekhane bosate hobe. Na bosale website-e save hobe na,\n//    kintu WhatsApp tobuo khulbe.\nconst WORKER_URL = 'https://uob-admission.contacts-anik1.workers.dev';\nconst WHATSAPP_NUMBER = '8801313430064'; // Admission helpline (01313-430064)\n\ndocument.getElementById('inquiry-form').addEventListener('submit', function(e){\n  e.preventDefault();\n  var name = document.getElementById('name').value.trim();\n  var phone = document.getElementById('phone').value.trim();\n  var program = document.getElementById('program').value;\n  var ssc = document.getElementById('ssc').value.trim();\n  var hsc = document.getElementById('hsc').value.trim();\n  var honours = document.getElementById('honours').value.trim();\n  var message = document.getElementById('message').value.trim();\n  var lines = ['ভর্তি বিষয়ে জানতে চাই', 'নাম: ' + name, 'ফোন: ' + phone, 'পছন্দের প্রোগ্রাম: ' + program];\n  if (ssc) lines.push('SSC GPA: ' + ssc);\n  if (hsc) lines.push('HSC GPA: ' + hsc);\n  if (honours) lines.push('অনার্স/CGPA: ' + honours);\n  if (message) lines.push('প্রশ্ন: ' + message);\n\n  var statusEl = document.getElementById('form-status');\n\n  // 1) Website-e save korar chesta — 5 second er beshi wait korbo na,\n  //    ar fail korleo WhatsApp atke thakbe na.\n  var savePromise;\n  if (WORKER_URL.indexOf('REPLACE-ME') === -1) {\n    var controller = new AbortController();\n    var timeoutId = setTimeout(function(){ controller.abort(); }, 5000);\n    savePromise = fetch(WORKER_URL + '/api/enquiry', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ name: name, phone: phone, program: program, ssc_gpa: ssc, hsc_gpa: hsc, honours_cgpa: honours, message: message }),\n      signal: controller.signal\n    }).then(function(res){ return res.ok; }).catch(function(){ return false; })\n      .then(function(ok){ clearTimeout(timeoutId); return ok; });\n  } else {\n    savePromise = Promise.resolve(false);\n  }\n\n  savePromise.then(function(ok){\n    if (statusEl) {\n      statusEl.textContent = ok\n        ? '✓ আপনার মেসেজটি ওয়েবসাইটে জমা হয়েছে, আর WhatsApp-ও খুলছে — ওখানে Send চাপলেই হবে।'\n        : 'WhatsApp খুলছে — ওখানে Send চাপলেই আপনার মেসেজটি Admission টিমের কাছে যাবে। (এইবার ওয়েবসাইটে জমা হয়নি, শুধু WhatsApp-এ যাচ্ছে।)';\n    }\n  });\n\n  // 2) WhatsApp — sob somoy khulbe, save hok ba na hok.\n  window.open('https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(lines.join('\\n')), '_blank');\n});\n</script>\n</body>\n</html>\n";

async function serveStatic(request, env, path) {
  if (!env.ASSETS || typeof env.ASSETS.fetch !== "function") return null;
  let assetPath = path;
  if (assetPath === "/") assetPath = "/index.html";
  const assetUrl = new URL(request.url);
  assetUrl.pathname = assetPath;
  return env.ASSETS.fetch(new Request(assetUrl.toString(), request));
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const path = url.pathname.replace(/\/+$/, "") || "/";
    const method = request.method.toUpperCase();
    const base = { ...corsHeaders(request, env) };

    try {
      if (method === "OPTIONS") {
        return new Response(null, { status: 204, headers: securityHeaders(base) });
      }

      // Admin panel — Worker-er vitore embed kora, ASSETS diye na,
      // tai redirect loop hote pare na.
      if ((method === "GET" || method === "HEAD") && (path === "/admin" || path === "/admin.html")) {
        const headers = securityHeaders({ ...base, "Content-Type": "text/html; charset=utf-8" });
        return new Response(method === "HEAD" ? null : ADMIN_HTML, { status: 200, headers });
      }

      let response;
      if (path === "/" && method === "GET") {
        const asset = await serveStatic(request, env, path);
        if (asset && asset.status === 200) {
          const headers = new Headers(asset.headers);
          for (const [k, v] of Object.entries(securityHeaders(base))) {
            if (!headers.has(k)) headers.set(k, v);
          }
          return new Response(asset.body, { status: 200, headers });
        }
        // ASSETS-e index.html na pele embedded copy dao.
        return new Response(INDEX_HTML, {
          status: 200,
          headers: securityHeaders({ ...base, "Content-Type": "text/html; charset=utf-8" }),
        });
      } else if (path === "/index.html" && method === "GET") {
        const asset = await serveStatic(request, env, path);
        if (asset && asset.status === 200) {
          const headers = new Headers(asset.headers);
          for (const [k, v] of Object.entries(securityHeaders(base))) {
            if (!headers.has(k)) headers.set(k, v);
          }
          return new Response(asset.body, { status: 200, headers });
        }
        return new Response(INDEX_HTML, {
          status: 200,
          headers: securityHeaders({ ...base, "Content-Type": "text/html; charset=utf-8" }),
        });
      } else if (path === "/api/health" && method === "GET") {
        response = handleHealth(env);
      } else if (path === "/api/enquiry" && method === "POST") {
        response = await handleEnquiry(request, env);
      } else if (path === "/api/admin/login" && method === "POST") {
        response = await handleLogin(request, env);
      } else if (path === "/api/admin/logout" && method === "POST") {
        response = await handleLogout(request, env);
      } else if (path === "/api/admin/me" && method === "GET") {
        response = await handleMe(request, env);
      } else if (path === "/api/admin/enquiries" && method === "GET") {
        response = await handleListEnquiries(request, env, url);
      } else if (path.startsWith("/api/admin/enquiries/") && method === "PATCH") {
        response = await handleUpdateEnquiry(request, env, path.slice("/api/admin/enquiries/".length));
      } else if (path.startsWith("/api/")) {
        response = json({ error: "Not found" }, 404);
      } else if (method === "GET" || method === "HEAD") {
        const asset = await serveStatic(request, env, path);
        if (asset && asset.status === 200) {
          const headers = new Headers(asset.headers);
          for (const [k, v] of Object.entries(securityHeaders(base))) {
            if (!headers.has(k)) headers.set(k, v);
          }
          return new Response(asset.body, { status: 200, headers });
        }
        response = json({ error: "Not found" }, 404);
      } else {
        response = json({ error: "Not found" }, 404);
      }

      const headers = new Headers(response.headers);
      for (const [k, v] of Object.entries(securityHeaders(base))) {
        headers.set(k, v);
      }
      return new Response(response.body, { status: response.status, headers });
    } catch (err) {
      console.error("Unhandled error:", err);
      return json({ error: "Internal server error" }, 500, securityHeaders(base));
    }
  },
};

