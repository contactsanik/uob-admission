  .msg{padding:11px 13px;border-radius:9px;margin:12px 0;font-size:14px;display:none}
  .msg.err{display:block;background:var(--red-bg);color:var(--red)}
  .msg.ok{display:block;background:#e6f4ea;color:#14532d}
  .msg.info{display:block;background:#e8f0fe;color:#174ea6}
  .note{background:var(--gold-soft);border:1px solid #ead98a;border-radius:10px;padding:13px 15px;font-size:14.5px;margin:12px 0}
  .item{border:1px solid var(--line);border-left:4px solid var(--green);border-radius:10px;padding:15px;margin:12px 0;background:#fff}
  .item h3{margin:0 0 4px;font-size:17px}
  .item p{margin:4px 0;font-size:14.5px;color:#44506a}
  .badge{display:inline-block;font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;background:#e6f4ea;color:#14532d}
  .badge.new{background:var(--amber-bg);color:var(--amber)}
  .badge.done{background:#e8f0fe;color:#174ea6}
  .hidden{display:none !important}
  .stats{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}
  .stat{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 16px;font-size:14px}
  .stat b{font-size:19px;color:var(--green)}
  footer{text-align:center;color:var(--muted);font-size:13px;padding:10px 0 20px}
</style>
</head>
<body>
<header>
  <div class="topbar">
    <div class="mark">UOB</div>
    <div>
      <h1>Admin — Admission Hub</h1>
      <p>ব্রাহ্মণবাড়িয়া বিশ্ববিদ্যালয় — ভর্তির ইনকোয়ারি</p>
    </div>
    <div class="spacer"></div>
    <a class="pill" href="/" target="_blank" rel="noopener">ওয়েবসাইট দেখো</a>
    <button class="pill hidden" id="logoutBtn" type="button">Logout</button>
  </div>
</header>

<div class="wrap">

  <div class="card" id="loginCard">
    <h2>লগইন করো</h2>
    <p class="muted">তোমার admin email আর password দাও। Session token শুধু এই tab-এ মনে থাকবে (sessionStorage)। Tab বন্ধ করলে মুছে যাবে।</p>
    <label for="loginEmail">Email</label>
    <input id="loginEmail" type="email" placeholder="তোমার admin email" autocomplete="username">
    <label for="loginPassword">Password</label>
    <input id="loginPassword" type="password" placeholder="তোমার admin password" autocomplete="current-password">
    <div class="actions"><button class="btn-green" id="loginBtn" type="button">Login</button></div>
    <div id="loginMsg" class="msg"></div>
    <p class="muted">Email / password হচ্ছে তুমি <code>wrangler secret put ADMIN_EMAIL</code> আর <code>wrangler secret put ADMIN_PASSWORD</code> দিয়ে যেটা দিয়েছিলে, ওটা।</p>
  </div>

  <div id="app" class="hidden">
    <div class="card">
      <h2>ইনকোয়ারি (<span id="enquiryCount">0</span>)</h2>
      <div class="note"><b>মনে রাখবা:</b> নিচের Reply note-টা তোমাকে হাতে লিখতে হবে। WhatsApp-এ তুমি যে reply দিলা, ওটা এখানে নিজে থেকে আসবে না — wa.me লিংক দিয়ে WhatsApp-এর reply sync করা যায় না। WhatsApp-এ reply দেওয়ার পর এখানে এসে কী বললা, সেটা লিখে status-টা বদলে দিও।</div>
      <div class="stats">
        <div class="stat">নতুন: <b id="countNew">0</b></div>
        <div class="stat">উত্তর দেওয়া: <b id="countReplied">0</b></div>
        <div class="stat">শেষ: <b id="countDone">0</b></div>
      </div>
      <label for="enqFilter">Status দিয়ে দেখো</label>
      <select id="enqFilter">
        <option value="">সবগুলো</option>
        <option value="new">new — নতুন</option>
        <option value="replied">replied — উত্তর দেওয়া</option>
        <option value="done">done — শেষ</option>
      </select>
      <div class="actions"><button class="btn-ghost btn-small" id="refreshBtn" type="button">↻ Refresh</button></div>
      <div id="enquiryList" style="margin-top:10px"><p class="muted">লোড হচ্ছে...</p></div>
    </div>
    <footer>Admin panel — শুধু তোমার জন্য। তোমার email / password কাউকে দিবা না।</footer>
  </div>

</div>

<script>
(function () {
  "use strict";
  var TOKEN_KEY = "uob_admin_session";
  var loginEmail = document.getElementById("loginEmail");
  var loginPassword = document.getElementById("loginPassword");
  var loginMsg = document.getElementById("loginMsg");

  function token() {
    try { return sessionStorage.getItem(TOKEN_KEY) || ""; } catch (e) { return ""; }
  }
  function saveToken(t) {
    try { sessionStorage.setItem(TOKEN_KEY, t); } catch (e) {}
  }
  function clearToken() {
    try { sessionStorage.removeItem(TOKEN_KEY); } catch (e) {}
  }
  function showMsg(el, text, kind) {
    el.textContent = text;
    el.className = "msg " + (kind || "info");
  }
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }

  async function api(path, options) {
    options = options || {};
    var headers = { "Content-Type": "application/json" };
    if (token()) headers["Authorization"] = "Bearer " + token();
    var res;
    try {
      res = await fetch(path, {
        method: options.method || "GET",
        headers: headers,
        body: options.body ? JSON.stringify(options.body) : undefined
      });
    } catch (e) {
      throw new Error("Backend-এ পৌঁছানো যাচ্ছে না। Backend deploy হয়েছে কিনা দেখো। (" + e.message + ")");
    }
    var data = {};
    try { data = await res.json(); } catch (e) { data = {}; }
    if (res.status === 401) throw new Error("Login হয় নাই — email / password দিয়ে আবার login করো।");
    if (res.status === 503) throw new Error("Admin login / D1 এখনো Worker-এ set করা হয় নাই। আগে secret + D1 setup শেষ করো।");
    if (!res.ok) throw new Error(data.error || ("Request fail হয়েছে (HTTP " + res.status + ")"));
    return data;
  }

  function showApp(loggedIn) {
    document.getElementById("loginCard").classList.toggle("hidden", loggedIn);
    document.getElementById("app").classList.toggle("hidden", !loggedIn);
    document.getElementById("logoutBtn").classList.toggle("hidden", !loggedIn);
    if (loggedIn) loadEnquiries();
  }

  async function doLogout() {
    try { await api("/api/admin/logout", { method: "POST" }); } catch (e) {}
    clearToken();
    loginPassword.value = "";
    showMsg(loginMsg, "Logout হয়েছে।", "info");
    showApp(false);
  }

  document.getElementById("loginBtn").addEventListener("click", async function () {
    var email = loginEmail.value.trim();
    var password = loginPassword.value;
    if (!email || !password) { showMsg(loginMsg, "Email আর password — দুইটাই দাও।", "err"); return; }
    showMsg(loginMsg, "Login হচ্ছে...", "info");
    try {
      var res = await fetch("/api/admin/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email, password: password })
      });
      var data = {};
      try { data = await res.json(); } catch (e) { data = {}; }
      if (!res.ok) throw new Error(data.error || "Login হয় নাই।");
      saveToken(data.token);
      loginPassword.value = "";
      showMsg(loginMsg, "", "info");
      showApp(true);
    } catch (e) {
      showMsg(loginMsg, "❌ " + e.message, "err");
    }
  });
  loginPassword.addEventListener("keydown", function (ev) {
    if (ev.key === "Enter") document.getElementById("loginBtn").click();
  });
  document.getElementById("logoutBtn").addEventListener("click", doLogout);

  (async function () {
    if (!token()) return;
    try {
      await api("/api/admin/me");
      showApp(true);
    } catch (e) { clearToken(); }
  })();

  var cache = [];
  function statusLabel(s) {
    if (s === "new") return "new — নতুন";
    if (s === "replied") return "replied — উত্তর দেওয়া";
    return "done — শেষ";
  }

  async function loadEnquiries() {
    var list = document.getElementById("enquiryList");
    var status = document.getElementById("enqFilter").value;
    try {
      var q = "/api/admin/enquiries?limit=100" + (status ? "&status=" + encodeURIComponent(status) : "");
      var data = await api(q);
      cache = data.enquiries || [];
      document.getElementById("enquiryCount").textContent = data.count || cache.length;
      var counts = { "new": 0, "replied": 0, "done": 0 };
      cache.forEach(function (e) { if (counts[e.status] !== undefined) counts[e.status] += 1; });
      document.getElementById("countNew").textContent = counts["new"];
      document.getElementById("countReplied").textContent = counts["replied"];
      document.getElementById("countDone").textContent = counts["done"];
      if (!cache.length) { list.innerHTML = "<p class='muted'>কোনো inquiry নাই।</p>"; return; }
      list.innerHTML = cache.map(function (e) {
        var time = "";
        try { time = new Date(e.createdAt).toLocaleString("bn-BD"); } catch (err) { time = e.createdAt || ""; }
        var digits = (e.phone || "").replace(/[^0-9]/g, "");
        var wa = digits;
        if (wa.indexOf("880") === 0) { /* already full international number */ }
        else if (wa.charAt(0) === "0") { wa = "88" + wa; }
        else if (wa) { wa = "880" + wa; }
        return "<div class='item' data-id='" + esc(e.id) + "'>" +
          "<h3>" + esc(e.name || "No name") + " · " + esc(e.program || "") + " " +
          "<span class='badge " + esc(e.status || "new") + "'>" + esc(statusLabel(e.status || "new")) + "</span></h3>" +
          "<p>" + esc(e.message || "") + "</p>" +
          "<p class='muted'>" +
          "ফোন: <a href='tel:" + esc(e.phone || "") + "'>" + esc(e.phone || "") + "</a> · " +
          "<a href='https://wa.me/" + esc(wa) + "' target='_blank' rel='noopener'>WhatsApp-এ লিখো</a><br>" +
          (e.sscGpa ? "SSC GPA: " + esc(e.sscGpa) + "<br>" : "") +
          (e.hscGpa ? "HSC GPA: " + esc(e.hscGpa) + "<br>" : "") +
          (e.honoursCgpa ? "অনার্স/CGPA: " + esc(e.honoursCgpa) + "<br>" : "") +
          (time ? "সময়: " + esc(time) : "") +
          "</p>" +
          "<label>Status</label>" +
          "<select class='st'>" +
          "<option value='new'" + (e.status === "new" ? " selected" : "") + ">new — নতুন</option>" +
          "<option value='replied'" + (e.status === "replied" ? " selected" : "") + ">replied — উত্তর দেওয়া</option>" +
          "<option value='done'" + (e.status === "done" ? " selected" : "") + ">done — শেষ</option>" +
          "</select>" +
          "<label>Reply note — WhatsApp-এ কী উত্তর দিলা, এখানে লিখে রাখো</label>" +
          "<textarea class='note' placeholder='যেমন: ফি জানানো হয়েছে, ১২ নভেম্বর ফোন করা হয়েছে...'>" + esc(e.replyNote || "") + "</textarea>" +
          "<div class='actions'><button class='btn-green btn-small saveBtn' type='button'>💾 Save</button></div>" +
          "<p class='muted saveMsg'></p>" +
          "</div>";
      }).join("");
    } catch (e) {
      list.innerHTML = "<p class='muted'>❌ " + esc(e.message) + "</p>";
    }
  }
  document.getElementById("refreshBtn").addEventListener("click", loadEnquiries);
  document.getElementById("enqFilter").addEventListener("change", loadEnquiries);

  document.getElementById("enquiryList").addEventListener("click", async function (ev) {
    var btn = ev.target.closest(".saveBtn");
    if (!btn) return;
    var card = btn.closest(".item");
    if (!card) return;
    var id = card.getAttribute("data-id");
    var status = card.querySelector(".st").value;
    var replyNote = card.querySelector(".note").value;
    var msgEl = card.querySelector(".saveMsg");
    msgEl.textContent = "Save হচ্ছে...";
    try {
      await api("/api/admin/enquiries/" + encodeURIComponent(id), {
        method: "PATCH", body: { status: status, reply_note: replyNote }
      });
      msgEl.textContent = "✓ Save হয়েছে।";
      loadEnquiries();
    } catch (e) {
      msgEl.textContent = "❌ " + e.message;
    }
  });
})();
</script>
</body>
</html>`;

